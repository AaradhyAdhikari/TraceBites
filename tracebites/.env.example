# Local Postgres (docker compose up -d)
DATABASE_URL="postgresql://tracebites:tracebites@localhost:5433/tracebites"

# Public origin — used to build the URL encoded into every batch QR code.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ledger salt. Personal data never goes on chain; it is hashed with this salt.
# Deleting a person's salt is the crypto-erasure that satisfies DPDP Act erasure requests.
# Generate with: openssl rand -hex 32
LEDGER_SALT="dev-only-salt-replace-before-any-real-data"

# Signs session cookies. MUST NOT be the same value as LEDGER_SALT: the salt can
# never rotate without breaking verification of every past event, while this key
# must rotate the moment it might have leaked.
# Generate with: openssl rand -hex 32
SESSION_SECRET="dev-only-session-secret"

# Peppers one-time codes before hashing. Rotating it invalidates codes in flight,
# which is harmless — they last five minutes.
OTP_PEPPER="dev-only-otp-pepper"

# Chain adapter: "local" (no network, deterministic fake receipts) or "polygon".
CHAIN_ADAPTER="local"

# --- only needed when CHAIN_ADAPTER=polygon ---
# POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
# REGISTRY_CONTRACT_ADDRESS="0x..."
# RELAYER_PRIVATE_KEY="0x..."   # never commit this; use a KMS in anything but local dev
